# Tasty ERP Environment Variables
# Copy to .env and fill in values

# ==================== Firebase ====================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH="C:\Users\Boris\Dell\Projects\APPS\ERP\Tasty_erp_new\secrets\firebase-sa.json"

# ==================== RS.ge SOAP ====================
SOAP_ENDPOINT=https://services.rs.ge/WayBillService/WayBillService.asmx
SOAP_SU=username:seller_id
SOAP_SP=your_password

# ==================== Business Logic ====================
CUTOFF_DATE=2025-04-29
PAYMENT_CUTOFF_DATE=2025-04-29
BATCH_SIZE=100
MAX_DATE_RANGE_MONTHS=12

# ==================== Service URLs (for gateway) ====================
WAYBILL_SERVICE_URL=http://waybill-service:8081
PAYMENT_SERVICE_URL=http://payment-service:8082
CONFIG_SERVICE_URL=http://config-service:8888

# ==================== CORS ====================
FRONTEND_URL=https://your-frontend-domain.com
# Optional second allowed origin pattern (only used if set)
ALLOWED_ORIGIN_PATTERN=http://localhost:3000

# ==================== Gateway rate limiting ====================
RATE_LIMIT_CAPACITY=200
RATE_LIMIT_TOKENS=100
RATE_LIMIT_PERIOD_SECONDS=60

# ==================== Logging ====================
LOG_LEVEL=INFO

# ==================== TBC DBI (Direct Bank Integration) ====================
# SOAP + mutual TLS + WS-Security per request — NOT OAuth. Credentials are the
# DBI username/password and the PKCS12 (.pfx) client certificate issued by TBC
# for this legal entity. See TBC_INTEGRATION_ANALYSIS.md.
TBC_DBI_ENABLED=false
TBC_DBI_ENDPOINT=https://secdbi.tbconline.ge/dbi/dbiService
TBC_DBI_USERNAME=
TBC_DBI_PASSWORD=
# Provide the certificate either as a file path OR base64-encoded:
TBC_DBI_CERTIFICATE_PATH=
TBC_DBI_CERTIFICATE_BASE64=
TBC_DBI_CERTIFICATE_PASSWORD=
TBC_DBI_ACCOUNT_NUMBER=
TBC_DBI_CURRENCY=GEL
TBC_DBI_PAGE_SIZE=700
TBC_DBI_TIMEOUT_SECONDS=120

# ==================== Bank sync scheduling ====================
BANK_SYNC_INTERVAL=60
BANK_SYNC_OVERLAP_DAYS=3
BANK_SYNC_MIN_INTERVAL_SECONDS=120
# First backfill start (yyyy-MM-dd). Blank = day after PAYMENT_CUTOFF_DATE.
BANK_SYNC_START_DATE=

# ==================== Future: BOG Banking API ====================
BOG_BANK_API_ENABLED=false
BOG_BANK_API_URL=
BOG_BANK_API_KEY=
